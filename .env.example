# Copy to .env and fill in. Then: docker compose up -d --build

# The presenter's login.
LIVE_ADMIN_USER=tomas

# Argon2id hash from `npm run hash-password`, the .env line. Keep the single quotes:
# without them Compose expands the $ signs in the hash.
LIVE_ADMIN_PASSWORD_HASH='$argon2id$replace-me'

# The site's exact origin. Used for Origin checks and in QR codes.
# Leave empty to compare against the Host header, for local use.
LIVE_PUBLIC_ORIGIN=https://live.hutnan.dev

# Optional link on the public homepage to a write-up about the service.
# LIVE_ABOUT_URL=https://example.com/projects/live

# Who may set X-Forwarded-*. The default fits this compose file, where only the
# local Caddy can reach the port. Use a narrower address or CIDR if you can.
# LIVE_TRUST_PROXY=loopback,uniquelocal

# Only for compose.vps.yaml, which builds the origin from LIVE_DOMAIN.
LIVE_DOMAIN=live.hutnan.dev
LIVE_DATA_PATH=/home/deploy/data/live
# A commit (sha-1a2b3c4) or version tag, to pin or roll back.
# LIVE_IMAGE_TAG=latest
